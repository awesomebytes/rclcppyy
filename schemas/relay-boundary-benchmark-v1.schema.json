{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/awesomebytes/rclcppyy/schemas/relay-boundary-benchmark-v1.schema.json",
  "title": "rclcppyy controlled seven-lane relay boundary benchmark v1",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "command",
    "environment",
    "benchmark",
    "results",
    "comparison",
    "failures"
  ],
  "properties": {
    "schema": {"const": "rclcppyy.relay-boundary-benchmark/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "command": {"type": "array", "items": {"type": "string"}},
    "environment": {"type": "object"},
    "benchmark": {
      "type": "object",
      "required": [
        "name",
        "mode",
        "performance_claims_allowed",
        "parameters",
        "isolation",
        "aot_build",
        "cache",
        "source_files",
        "statistics",
        "scope"
      ],
      "properties": {
        "name": {"const": "controlled_ros_relay_boundary"},
        "mode": {"enum": ["smoke", "measurement"]},
        "performance_claims_allowed": {"const": false},
        "parameters": {
          "type": "object",
          "required": [
            "variants",
            "messages",
            "warmup_messages",
            "repetitions",
            "requested_rmw",
            "qos",
            "execution_order"
          ],
          "properties": {
            "variants": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/variant"}
            },
            "messages": {"type": "integer", "minimum": 1, "maximum": 100000},
            "warmup_messages": {"type": "integer", "minimum": 1, "maximum": 100000},
            "repetitions": {"type": "integer", "minimum": 1, "maximum": 30},
            "requested_rmw": {"type": "string", "minLength": 1},
            "qos": {"$ref": "#/$defs/qos"},
            "execution_order": {"type": "array", "items": {"type": "string"}}
          }
        },
        "isolation": {
          "type": "object",
          "required": [
            "fresh_process_pair_per_sample",
            "two_process_groups_per_sample",
            "unique_topics_per_sample",
            "one_leased_domain_per_run",
            "rotating_variant_order",
            "ros_domain_id"
          ],
          "properties": {
            "fresh_process_pair_per_sample": {"const": true},
            "two_process_groups_per_sample": {"const": true},
            "unique_topics_per_sample": {"const": true},
            "one_leased_domain_per_run": {"const": true},
            "rotating_variant_order": {"const": true},
            "ros_domain_id": {"type": "integer", "minimum": 0, "maximum": 232}
          }
        },
        "aot_build": {"type": "object"},
        "cache": {"type": "object"},
        "source_files": {"type": "object"},
        "statistics": {"type": "object"},
        "scope": {"type": "object"}
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema",
          "case_id",
          "variant",
          "repetition",
          "run_token",
          "ros_domain_id",
          "requested_rmw",
          "qos",
          "relay_pid",
          "driver_pid",
          "topology",
          "relay_ready",
          "relay_armed",
          "relay_report",
          "driver_result",
          "driver_teardown",
          "timing",
          "backend_verified",
          "correctness_verified",
          "teardown_verified"
        ],
        "properties": {
          "schema": {"const": "rclcppyy.relay-boundary-sample/v1"},
          "variant": {"$ref": "#/$defs/variant"},
          "repetition": {"type": "integer", "minimum": 1},
          "run_token": {"type": "string", "pattern": "^run_[a-f0-9]{32}$"},
          "ros_domain_id": {"type": "integer", "minimum": 0, "maximum": 232},
          "requested_rmw": {"type": "string", "minLength": 1},
          "qos": {"$ref": "#/$defs/qos"},
          "relay_pid": {"type": "integer", "minimum": 1},
          "driver_pid": {"type": "integer", "minimum": 1},
          "backend_verified": {"const": true},
          "correctness_verified": {"const": true},
          "teardown_verified": {"const": true},
          "relay_ready": {
            "type": "object",
            "required": ["schema", "event", "variant", "execution_model"],
            "properties": {
              "schema": {"const": "rclcppyy.relay-boundary-relay-event/v1"},
              "event": {"const": "ready"},
              "variant": {"$ref": "#/$defs/variant"},
              "execution_model": {"type": "string", "minLength": 1}
            }
          },
          "relay_report": {
            "type": "object",
            "required": ["schema", "event", "cpu_time_ns", "cpu_clock", "rss_guard"],
            "properties": {
              "schema": {"const": "rclcppyy.relay-boundary-relay-event/v1"},
              "event": {"const": "report"},
              "cpu_time_ns": {"type": "integer", "minimum": 0},
              "cpu_clock": {"const": "CLOCK_PROCESS_CPUTIME_ID"},
              "rss_guard": {"$ref": "#/$defs/rss_guard"}
            }
          },
          "relay_armed": {
            "type": "object",
            "required": ["schema", "event", "variant", "run_token", "pid", "process_group_id", "cpu_clock"],
            "properties": {
              "schema": {"const": "rclcppyy.relay-boundary-relay-event/v1"},
              "event": {"const": "armed"},
              "variant": {"$ref": "#/$defs/variant"},
              "cpu_clock": {"const": "CLOCK_PROCESS_CPUTIME_ID"}
            }
          },
          "driver_result": {
            "type": "object",
            "required": ["schema", "event", "cpu_time_ns", "cpu_clock", "rss_guard", "latency_ns"],
            "properties": {
              "schema": {"const": "rclcppyy.relay-boundary-driver-event/v1"},
              "event": {"const": "measured"},
              "cpu_time_ns": {"type": "integer", "minimum": 0},
              "cpu_clock": {"const": "CLOCK_PROCESS_CPUTIME_ID"},
              "rss_guard": {"$ref": "#/$defs/rss_guard"},
              "latency_ns": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "integer", "minimum": 1}
              }
            }
          },
          "driver_teardown": {
            "type": "object",
            "required": ["schema", "event", "run_token", "pid", "process_group_id", "teardown_clean"],
            "properties": {
              "schema": {"const": "rclcppyy.relay-boundary-driver-event/v1"},
              "event": {"const": "teardown"},
              "teardown_clean": {"const": true}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"variant": {"const": "stock-rclpy"}}, "required": ["variant"]},
            "then": {"properties": {"relay_ready": {"properties": {"execution_model": {"const": "same-python-relay-stock-rclpy"}}}}}
          },
          {
            "if": {"properties": {"variant": {"const": "compatible-rclcppyy"}}, "required": ["variant"]},
            "then": {"properties": {"relay_ready": {"properties": {"execution_model": {"const": "same-python-relay-compatible-stock-publish"}}}}}
          },
          {
            "if": {"properties": {"variant": {"const": "publisher-cpp-rclcppyy"}}, "required": ["variant"]},
            "then": {"properties": {"relay_ready": {"properties": {"execution_model": {"const": "same-python-relay-explicit-publisher-cpp"}}}}}
          },
          {
            "if": {"properties": {"variant": {"const": "direct-cpp-rclcppyy"}}, "required": ["variant"]},
            "then": {
              "properties": {
                "relay_ready": {
                  "required": ["direct_cpp_proof"],
                  "properties": {
                    "execution_model": {"const": "same-python-relay-direct-rclcpp"},
                    "direct_cpp_proof": {
                      "type": "object",
                      "required": [
                        "actual_cpp_message_class",
                        "message_cpp_name",
                        "single_native_node_authority",
                        "session_node_count",
                        "callback_handoff",
                        "subscription_creation_route",
                        "python_message_conversion_guarded",
                        "serialization_guarded"
                      ],
                      "properties": {
                        "actual_cpp_message_class": {"const": true},
                        "message_cpp_name": {"const": "std_msgs::msg::UInt64_<std::allocator<void>>"},
                        "single_native_node_authority": {"const": true},
                        "session_node_count": {"const": 1},
                        "callback_handoff": {"const": "one_native_cpp_copy"},
                        "subscription_creation_route": {"const": "prebuilt_subscription_trampoline"},
                        "python_message_conversion_guarded": {"const": true},
                        "serialization_guarded": {"const": true}
                      }
                    }
                  }
                },
                "relay_report": {
                  "required": [
                    "owning_cpp_callback_copies",
                    "cpp_callback_messages",
                    "non_cpp_callback_messages",
                    "python_message_conversions",
                    "serialization_operations",
                    "boundary_guard_calls"
                  ],
                  "properties": {
                    "owning_cpp_callback_copies": {"type": "integer", "minimum": 1},
                    "cpp_callback_messages": {"type": "integer", "minimum": 1},
                    "non_cpp_callback_messages": {"const": 0},
                    "python_message_conversions": {"const": 0},
                    "serialization_operations": {"const": 0},
                    "boundary_guard_calls": {
                      "type": "object",
                      "required": ["python_message_conversion", "serialization"],
                      "properties": {
                        "python_message_conversion": {"const": 0},
                        "serialization": {"const": 0}
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"variant": {"const": "native-python-callback"}}, "required": ["variant"]},
            "then": {"properties": {"relay_ready": {"properties": {"execution_model": {"const": "native-rclcpp-python-transform-callback"}}}}}
          },
          {
            "if": {"properties": {"variant": {"const": "native-fused"}}, "required": ["variant"]},
            "then": {"properties": {"relay_ready": {"properties": {"execution_model": {"const": "native-content-addressed-fused-cpp-relay"}}}}}
          },
          {
            "if": {"properties": {"variant": {"const": "aot-staged"}}, "required": ["variant"]},
            "then": {"properties": {"relay_ready": {"properties": {"execution_model": {"const": "conventional-release-aot-staged-relay"}}}}}
          }
        ]
      }
    },
    "comparison": {
      "type": "object",
      "required": [
        "raw_medians",
        "paired_ratios_to_stock",
        "paired_ratios_to_aot",
        "interpretation_allowed",
        "note"
      ],
      "properties": {
        "interpretation_allowed": {"const": false},
        "raw_medians": {"type": "object"},
        "paired_ratios_to_stock": {"type": "object"},
        "paired_ratios_to_aot": {"type": "object"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "failures": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "variant": {
      "enum": [
        "stock-rclpy",
        "compatible-rclcppyy",
        "publisher-cpp-rclcppyy",
        "direct-cpp-rclcppyy",
        "native-python-callback",
        "native-fused",
        "aot-staged"
      ]
    },
    "qos": {
      "type": "object",
      "required": ["history", "depth", "reliability", "durability"],
      "properties": {
        "history": {"const": "keep_last"},
        "depth": {"const": 1},
        "reliability": {"const": "reliable"},
        "durability": {"const": "volatile"}
      }
    },
    "rss_guard": {
      "type": "object",
      "required": [
        "kind",
        "unit",
        "baseline_peak_bytes",
        "final_peak_bytes",
        "growth_bytes",
        "limit_bytes",
        "within_limit"
      ],
      "properties": {
        "kind": {"const": "post-warmup-peak-rss-growth"},
        "unit": {"const": "bytes"},
        "baseline_peak_bytes": {"type": "integer", "minimum": 1},
        "final_peak_bytes": {"type": "integer", "minimum": 1},
        "growth_bytes": {"type": "integer", "minimum": 0},
        "limit_bytes": {"const": 67108864},
        "within_limit": {"const": true}
      }
    }
  }
}
