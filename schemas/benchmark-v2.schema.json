{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/awesomebytes/rclcppyy/schemas/benchmark-v2.schema.json",
  "title": "rclcppyy benchmark matrix result v2",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "command",
    "environment",
    "benchmark",
    "results",
    "failures"
  ],
  "properties": {
    "schema": {"const": "rclcppyy.benchmark/v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "command": {"type": "array", "items": {"type": "string"}},
    "environment": {"type": "object"},
    "benchmark": {
      "type": "object",
      "required": ["name", "mode", "performance_claims_allowed", "matrix", "statistics"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "mode": {"enum": ["measurement", "smoke"]},
        "performance_claims_allowed": {"const": false},
        "matrix": {"type": "object"},
        "statistics": {"type": "object"}
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "backend",
          "workload",
          "target_rate_hz",
          "payload_bytes",
          "backend_verified",
          "messages",
          "latency_us",
          "cpu_pct"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "backend": {"type": "string", "minLength": 1},
          "workload": {"type": "string", "minLength": 1},
          "target_rate_hz": {"type": "integer", "minimum": 1},
          "payload_bytes": {"type": "integer", "minimum": 0},
          "backend_verified": {"const": true},
          "messages": {
            "type": "object",
            "required": ["received", "dropped", "effective_rate_hz"]
          },
          "latency_us": {
            "type": "object",
            "required": ["count", "mean", "p50", "p95", "p99", "min", "max"]
          },
          "cpu_pct": {
            "type": "object",
            "required": ["publisher", "subscriber"]
          }
        }
      }
    },
    "failures": {"type": "array", "items": {"type": "object"}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "benchmark": {
            "properties": {"mode": {"const": "smoke"}},
            "required": ["mode"]
          }
        }
      },
      "then": {
        "properties": {
          "benchmark": {
            "properties": {"performance_claims_allowed": {"const": false}}
          }
        }
      }
    }
  ]
}
