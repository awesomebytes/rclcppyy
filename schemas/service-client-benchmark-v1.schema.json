{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/awesomebytes/rclcppyy/schemas/service-client-benchmark-v1.schema.json",
  "title": "rclcppyy Jazzy/Cyclone service client benchmark v1",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "command",
    "environment",
    "benchmark",
    "results",
    "comparison",
    "failures"
  ],
  "properties": {
    "schema": {"const": "rclcppyy.service-client-benchmark/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "command": {"type": "array", "items": {"type": "string"}},
    "environment": {"type": "object"},
    "benchmark": {
      "type": "object",
      "required": [
        "name",
        "mode",
        "performance_claims_allowed",
        "parameters",
        "isolation",
        "aot_build",
        "cache",
        "source_files",
        "statistics",
        "scope"
      ],
      "properties": {
        "name": {"const": "jazzy_cyclone_setbool_client_cpu"},
        "mode": {"enum": ["smoke", "measurement"]},
        "performance_claims_allowed": {"const": false},
        "parameters": {
          "type": "object",
          "required": [
            "variants",
            "messages",
            "warmup_requests",
            "repetitions",
            "requested_rmw",
            "qos",
            "execution_order"
          ],
          "properties": {
            "variants": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/variant"}
            },
            "messages": {"type": "integer", "minimum": 1, "maximum": 100000},
            "warmup_requests": {"type": "integer", "minimum": 1, "maximum": 100000},
            "repetitions": {"type": "integer", "minimum": 1, "maximum": 30},
            "requested_rmw": {"const": "rmw_cyclonedds_cpp"},
            "qos": {"$ref": "#/$defs/qos"},
            "execution_order": {"type": "array", "items": {"type": "string"}}
          }
        },
        "isolation": {
          "type": "object",
          "required": [
            "fresh_process_pair_per_sample",
            "two_process_groups_per_sample",
            "unique_service_per_sample",
            "one_leased_domain_per_run",
            "rotating_variant_order",
            "ros_domain_id"
          ],
          "properties": {
            "fresh_process_pair_per_sample": {"const": true},
            "two_process_groups_per_sample": {"const": true},
            "unique_service_per_sample": {"const": true},
            "one_leased_domain_per_run": {"const": true},
            "rotating_variant_order": {"const": true},
            "ros_domain_id": {"type": "integer", "minimum": 0, "maximum": 232}
          }
        },
        "aot_build": {"type": "object"},
        "cache": {"type": "object"},
        "source_files": {"type": "object"},
        "statistics": {"type": "object"},
        "scope": {
          "type": "object",
          "required": [
            "ros_distribution",
            "rmw",
            "steady_state_only",
            "maximum_rate_claim",
            "cross_machine_claim"
          ],
          "properties": {
            "ros_distribution": {"const": "jazzy"},
            "rmw": {"const": "rmw_cyclonedds_cpp"},
            "steady_state_only": {"const": true},
            "maximum_rate_claim": {"const": false},
            "cross_machine_claim": {"const": false}
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema",
          "case_id",
          "variant",
          "repetition",
          "run_token",
          "ros_domain_id",
          "requested_rmw",
          "qos",
          "server_pid",
          "client_pid",
          "topology",
          "server_ready",
          "client_warmed",
          "server_armed",
          "client_report",
          "server_report",
          "client_teardown",
          "timing",
          "backend_verified",
          "correctness_verified",
          "teardown_verified"
        ],
        "properties": {
          "schema": {"const": "rclcppyy.service-client-sample/v1"},
          "variant": {"$ref": "#/$defs/variant"},
          "repetition": {"type": "integer", "minimum": 1},
          "run_token": {"type": "string", "pattern": "^run_[a-f0-9]{32}$"},
          "ros_domain_id": {"type": "integer", "minimum": 0, "maximum": 232},
          "requested_rmw": {"const": "rmw_cyclonedds_cpp"},
          "qos": {"$ref": "#/$defs/qos"},
          "server_pid": {"type": "integer", "minimum": 1},
          "client_pid": {"type": "integer", "minimum": 1},
          "topology": {
            "type": "object",
            "required": [
              "process_count",
              "fresh_process_groups",
              "server_node",
              "client_node",
              "service_name"
            ],
            "properties": {
              "process_count": {"const": 2},
              "fresh_process_groups": {"const": true},
              "server_node": {"type": "string", "minLength": 1},
              "client_node": {"type": "string", "minLength": 1},
              "service_name": {"type": "string", "minLength": 1}
            }
          },
          "backend_verified": {"const": true},
          "correctness_verified": {"const": true},
          "teardown_verified": {"const": true},
          "server_ready": {
            "type": "object",
            "required": ["schema", "event", "execution_model", "service_type"],
            "properties": {
              "schema": {"const": "rclcppyy.service-client-server-event/v1"},
              "event": {"const": "ready"},
              "execution_model": {"const": "common-release-aot-setbool-server"},
              "service_type": {"const": "std_srvs/srv/SetBool"}
            }
          },
          "client_warmed": {
            "type": "object",
            "required": [
              "schema",
              "event",
              "variant",
              "execution_model",
              "client_authority",
              "warmup_requests",
              "topology_verified",
              "endpoint_count",
              "service_type",
              "qos_verified"
            ],
            "properties": {
              "schema": {"const": "rclcppyy.service-client-client-event/v1"},
              "event": {"const": "warmed"},
              "variant": {"$ref": "#/$defs/variant"},
              "execution_model": {"type": "string", "minLength": 1},
              "client_authority": {"enum": ["python", "cpp"]},
              "topology_verified": {"const": true},
              "endpoint_count": {"const": 1},
              "service_type": {"const": "std_srvs/srv/SetBool"},
              "qos_verified": {"const": true}
            }
          },
          "server_armed": {
            "type": "object",
            "required": [
              "schema",
              "event",
              "run_token",
              "pid",
              "process_group_id",
              "warmup_requests",
              "cpu_clock"
            ],
            "properties": {
              "schema": {"const": "rclcppyy.service-client-server-event/v1"},
              "event": {"const": "armed"},
              "cpu_clock": {"const": "CLOCK_PROCESS_CPUTIME_ID"}
            }
          },
          "client_report": {
            "type": "object",
            "required": [
              "schema",
              "event",
              "variant",
              "messages",
              "total_requests",
              "true_measured",
              "response_checksum",
              "python_orchestration_requests_measured",
              "python_request_crossings_measured",
              "python_response_crossings_measured",
              "python_message_conversions_measured",
              "exceptions",
              "pending_requests",
              "elapsed_ns",
              "cpu_time_ns",
              "cpu_clock",
              "rss_guard",
              "latency_ns"
            ],
            "properties": {
              "schema": {"const": "rclcppyy.service-client-client-event/v1"},
              "event": {"const": "measured"},
              "variant": {"$ref": "#/$defs/variant"},
              "cpp_request_copies_measured": {"type": "integer", "minimum": 1},
              "exceptions": {"const": 0},
              "pending_requests": {"const": 0},
              "cpu_time_ns": {"type": "integer", "minimum": 0},
              "cpu_clock": {"const": "CLOCK_PROCESS_CPUTIME_ID"},
              "rss_guard": {"$ref": "#/$defs/rss_guard"},
              "latency_ns": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "integer", "minimum": 1}
              }
            }
          },
          "server_report": {
            "type": "object",
            "required": [
              "schema",
              "event",
              "total_requests",
              "measured_requests",
              "response_checksum",
              "exceptions",
              "pending_requests",
              "cpu_time_ns",
              "cpu_clock",
              "rss_guard",
              "correct",
              "teardown_clean"
            ],
            "properties": {
              "schema": {"const": "rclcppyy.service-client-server-event/v1"},
              "event": {"const": "report"},
              "exceptions": {"const": 0},
              "pending_requests": {"const": 0},
              "cpu_time_ns": {"type": "integer", "minimum": 0},
              "cpu_clock": {"const": "CLOCK_PROCESS_CPUTIME_ID"},
              "rss_guard": {"$ref": "#/$defs/rss_guard"},
              "correct": {"const": true},
              "teardown_clean": {"const": true}
            }
          },
          "client_teardown": {
            "type": "object",
            "required": [
              "schema",
              "event",
              "variant",
              "run_token",
              "pid",
              "process_group_id",
              "endpoint_disappeared",
              "teardown_clean"
            ],
            "properties": {
              "schema": {"const": "rclcppyy.service-client-client-event/v1"},
              "event": {"const": "teardown"},
              "endpoint_disappeared": {"const": true},
              "teardown_clean": {"const": true}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"variant": {"const": "stock-rclpy"}}, "required": ["variant"]},
            "then": {"properties": {"client_warmed": {"properties": {"execution_model": {"const": "same-python-client-stock-rclpy"}, "client_authority": {"const": "python"}}}}}
          },
          {
            "if": {"properties": {"variant": {"const": "compatible-rclcppyy"}}, "required": ["variant"]},
            "then": {"properties": {"client_warmed": {"properties": {"execution_model": {"const": "same-python-client-compatible-activation"}, "client_authority": {"const": "python"}}}}}
          },
          {
            "if": {"properties": {"variant": {"const": "direct-cpp-rclcppyy"}}, "required": ["variant"]},
            "then": {
              "properties": {
                "client_warmed": {
                  "required": ["direct_cpp_proof"],
                  "properties": {
                    "execution_model": {"const": "direct-cpp-rclpy-call-shape-client"},
                    "client_authority": {"const": "cpp"},
                    "direct_cpp_proof": {
                      "type": "object",
                      "required": [
                        "profile",
                        "node_authority",
                        "client_authority",
                        "client_entity_type",
                        "runtime_facade_node_count",
                        "native_session_node_count",
                        "native_node_identity_verified",
                        "request_representation",
                        "response_representation",
                        "future_type",
                        "future_control",
                        "request_handoff",
                        "response_handoff",
                        "python_request_crossings_per_call",
                        "python_response_crossings_per_call",
                        "python_message_conversions_per_call",
                        "cpp_request_copies_per_call",
                        "python_conversion_guard_installed",
                        "serialization_guards_installed",
                        "status_decision"
                      ],
                      "properties": {
                        "profile": {"const": "direct_cpp"},
                        "node_authority": {"const": "cpp"},
                        "client_authority": {"const": "cpp"},
                        "client_entity_type": {"const": "rclcpp::Client<std_srvs::srv::SetBool>"},
                        "runtime_facade_node_count": {"const": 1},
                        "native_session_node_count": {"const": 1},
                        "native_node_identity_verified": {"const": true},
                        "request_representation": {"const": "actual_cpp"},
                        "response_representation": {"const": "actual_cpp"},
                        "future_type": {"const": "rclpy.task.Future"},
                        "future_control": {"const": "per_operation_rclpy_task_future"},
                        "request_handoff": {"const": "one_native_cpp_value_copy"},
                        "response_handoff": {"const": "shared_cpp_response"},
                        "python_request_crossings_per_call": {"const": 1},
                        "python_response_crossings_per_call": {"const": 1},
                        "python_message_conversions_per_call": {"const": 0},
                        "cpp_request_copies_per_call": {"const": 1},
                        "python_conversion_guard_installed": {"const": true},
                        "serialization_guards_installed": {"const": true},
                        "status_decision": {
                          "type": "object",
                          "required": ["id", "backend", "reason", "policies", "metadata"],
                          "properties": {
                            "id": {"type": "string", "pattern": "^entity-[0-9]{8}$"},
                            "backend": {"const": "cpp"},
                            "reason": {"const": "direct typed rclcpp client with C++ service messages"},
                            "policies": {"const": ["direct_cpp", "direct_cpp_service", "no_conversion", "per_operation_future", "cpp_pending_state"]},
                            "metadata": {"type": "object"}
                          }
                        }
                      }
                    }
                  }
                },
                "client_report": {
                  "required": ["cpp_request_copies_measured"]
                },
                "client_teardown": {
                  "required": ["direct_cpp_teardown"],
                  "properties": {
                    "direct_cpp_teardown": {
                      "type": "object",
                      "required": [
                        "endpoint_disappeared",
                        "client_closed",
                        "node_destroyed",
                        "context_shutdown",
                        "native_session_closed",
                        "native_session_released",
                        "native_executor_released",
                        "runtime_nodes_released"
                      ],
                      "properties": {
                        "endpoint_disappeared": {"const": true},
                        "client_closed": {"const": true},
                        "node_destroyed": {"const": true},
                        "context_shutdown": {"const": true},
                        "native_session_closed": {"const": true},
                        "native_session_released": {"const": true},
                        "native_executor_released": {"const": true},
                        "runtime_nodes_released": {"const": true}
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"variant": {"const": "native-python-orchestrated"}}, "required": ["variant"]},
            "then": {"properties": {"client_warmed": {"properties": {"execution_model": {"const": "native-session-python-orchestrated-client"}, "client_authority": {"const": "cpp"}}}}}
          },
          {
            "if": {"properties": {"variant": {"const": "native-cpp-state-machine"}}, "required": ["variant"]},
            "then": {"properties": {"client_warmed": {"properties": {"execution_model": {"const": "native-content-addressed-cpp-client-state-machine"}, "client_authority": {"const": "cpp"}}}}}
          },
          {
            "if": {"properties": {"variant": {"const": "aot-staged"}}, "required": ["variant"]},
            "then": {"properties": {"client_warmed": {"properties": {"execution_model": {"const": "conventional-release-aot-client"}, "client_authority": {"const": "cpp"}}}}}
          }
        ]
      }
    },
    "comparison": {
      "type": "object",
      "required": [
        "raw_medians",
        "paired_ratios_to_stock",
        "paired_ratios_to_aot",
        "interpretation_allowed",
        "note"
      ],
      "properties": {
        "interpretation_allowed": {"const": false},
        "raw_medians": {"type": "object"},
        "paired_ratios_to_stock": {"type": "object"},
        "paired_ratios_to_aot": {"type": "object"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "failures": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "variant": {
      "enum": [
        "stock-rclpy",
        "compatible-rclcppyy",
        "direct-cpp-rclcppyy",
        "native-python-orchestrated",
        "native-cpp-state-machine",
        "aot-staged"
      ]
    },
    "qos": {
      "type": "object",
      "required": ["history", "depth", "reliability", "durability"],
      "properties": {
        "history": {"const": "keep_last"},
        "depth": {"const": 10},
        "reliability": {"const": "reliable"},
        "durability": {"const": "volatile"}
      }
    },
    "rss_guard": {
      "type": "object",
      "required": [
        "kind",
        "unit",
        "baseline_peak_bytes",
        "final_peak_bytes",
        "growth_bytes",
        "limit_bytes",
        "within_limit"
      ],
      "properties": {
        "kind": {"const": "post-warmup-peak-rss-growth"},
        "unit": {"const": "bytes"},
        "baseline_peak_bytes": {"type": "integer", "minimum": 1},
        "final_peak_bytes": {"type": "integer", "minimum": 1},
        "growth_bytes": {"type": "integer", "minimum": 0},
        "limit_bytes": {"const": 67108864},
        "within_limit": {"const": true}
      }
    }
  }
}
